{
    "compilerOptions": {
          "target": "ES2022",
          "lib": ["ES2022", "DOM", "DOM.Iterable"],
          "types": ["vite/client"],
          "module": "ESNext",
          "moduleResolution": "Bundler",
          "jsx": "react-jsx",
          "strict": true,
          "noUnusedLocals": false,
          "noUnusedParameters": false,
          "esModuleInterop": true,
          "skipLibCheck": true,
          "resolveJsonModule": true,
          "isolatedModules": true,
          "allowImportingTsExtensions": false,
          "noEmit": true,
          "baseUrl": ".",
          "paths": {
                  "@/*": ["./src/*"]
          }
    },
    "include": ["src"]
}
